#
# Small ROCm XIO smoke test for an AMD GPU and an NVMe controller.
#
# Each job uses a distinct NVMe I/O queue ID, so the jobs do not race for
# rocm-xio's automatic queue choice. The filename uses a stable by-id link for
# the disposable MTR_SLC_16GB namespace; update it before use if that is not
# the intended test SSD.
#
# Example:
#   sudo env LD_LIBRARY_PATH=/opt/rocm/lib HSA_FORCE_FINE_GRAIN_PCIE=1 \
#     ./fio examples/rocm-xio-test.fio
#
# Notes:
# - This ioengine uses filename for fio's disk model and can auto-detect the
#   matching NVMe controller and namespace from that filename.
# - For host-memory mode 0 on bare metal, boot with IOMMU passthrough
#   (for example, iommu=pt) so device PRPs are usable by the NVMe controller.
# - Set rocm_xio_memory_mode=11 to exercise device-backed queues and buffers.
# - These jobs are read-only. Change rw=read to rw=write only on a disposable
#   target namespace.
# - The engine uses filename for fio capacity and offset accounting, so
#   size=100% covers the whole namespace.

[global]
ioengine=rocm_xio
filename=/dev/disk/by-id/nvme-MTR_SLC_16GB_0400000E3CBC
rocm_xio_gpu_id=0
rocm_xio_queue_length=128
rocm_xio_memory_mode=0
rocm_xio_batch_size=28
direct=1
thread=1
iodepth=64
rw=randread
bs=512
size=100%
group_reporting=1
time_based=1
runtime=30s

[rocm_xio_queue_27]
rocm_xio_queue_id=27

[rocm_xio_queue_28]
rocm_xio_queue_id=28

[rocm_xio_queue_29]
rocm_xio_queue_id=29

[rocm_xio_queue_30]
rocm_xio_queue_id=30

[rocm_xio_queue_31]
rocm_xio_queue_id=31

[rocm_xio_queue_32]
rocm_xio_queue_id=32
