#
# Small ROCm XIO smoke test for an AMD GPU and an NVMe controller.
#
# This example starts four fio jobs concurrently. Each job uses a distinct NVMe
# I/O queue ID, so the jobs do not race for rocm-xio's automatic queue choice.
# Update filename and rocm_xio_controller before use if /dev/nvme2n1 and
# /dev/nvme2 are not the intended test SSD.
#
# Example:
#   sudo env LD_LIBRARY_PATH=/opt/rocm/lib HSA_FORCE_FINE_GRAIN_PCIE=1 \
#     ./fio examples/rocm-xio-test.fio
#
# Notes:
# - This ioengine uses filename for fio's disk model and expects
#   rocm_xio_controller to name the matching NVMe controller.
# - For host-memory mode 0 on bare metal, boot with IOMMU passthrough
#   (for example, iommu=pt) so device PRPs are usable by the NVMe controller.
# - Set rocm_xio_memory_mode=11 to exercise device-backed queues and buffers.
# - These jobs are read-only. Change rw=read to rw=write only on a disposable
#   target namespace.
# - The engine uses filename for fio capacity and offset accounting, so
#   size=100% covers the whole namespace.

[global]
ioengine=rocm_xio
filename=/dev/nvme2n1
rocm_xio_controller=/dev/nvme2
rocm_xio_gpu_id=0
rocm_xio_queue_length=128
rocm_xio_nsid=1
rocm_xio_memory_mode=0
rocm_xio_batch_size=4
direct=1
iodepth=8
numjobs=1
thread=1
rw=randread
bs=4k
size=100%
time_based=1
runtime=30s

[rocm_xio_queue_29]
rocm_xio_queue_id=29

[rocm_xio_queue_30]
rocm_xio_queue_id=30

[rocm_xio_queue_31]
rocm_xio_queue_id=31

[rocm_xio_queue_32]
rocm_xio_queue_id=32
